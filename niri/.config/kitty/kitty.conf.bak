# https://sw.kovidgoyal.net/kitty/conf/#
# TEMP 
close_on_child_death no

# ─── Font ───────────────────────────────────────
font_family JetBrainsMono Nerd Font
font_size   11.0

# ─── Cursor ─────────────────────────────────────
shell_integration            no-cursor
cursor_shape                 block
cursor_blink_interval        0.5
cursor_stop_blinking_after   15.0
cursor_trail                 1
cursor_trail_decay           0.2 0.3
cursor_trail_start_threshold 5


# ─── Scrollback ─────────────────────────────────
scrollback_lines        10000
scrollbar               hovered
scrollbar_interactive   yes
scrollbar_width         1.0
scrollbar_radius        0
scrollbar_track_opacity 0

# ─── Mouse ──────────────────────────────────────
mouse_hide_wait 2.0

# ─── URL handling ───────────────────────────────
url_style     curly
open_url_with default
detect_urls   yes

# ─── Performance ────────────────────────────────
sync_to_monitor yes

# ─── Bell ───────────────────────────────────────
enable_audio_bell    no
visual_bell_duration 1.0

# ─── Window ─────────────────────────────────────
remember_window_size    yes
window_padding_width    2
window_padding_height   2
placement_strategy      top-left
hide_window_decorations yes
confirm_os_window_close 0
background_opacity      0.85

# ─── Tab bar ────────────────────────────────────
tab_bar_edge          bottom
tab_bar_style         powerline
tab_powerline_style   angled
tab_title_template    "{index}: {title} "
active_tab_font_style bold

# ─── Keyboard shortcuts ─────────────────────────
clear_all_shortcuts no

# TABS
map ctrl+shift+t new_tab_with_cwd
map ctrl+shift+w close_tab

# FONT
map ctrl+equal change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
map ctrl+0     change_font_size all 0

# WINDOW SPLITS
map ctrl+shift+d     launch --cwd=current --location=hsplit
map ctrl+shift+e     launch --cwd=current --location=vsplit
map ctrl+shift+right neighboring_window right
map ctrl+shift+left  neighboring_window left
map ctrl+shift+up    neighboring_window up
map ctrl+shift+down  neighboring_window down

#Clipboard
clipboard_control write-clipboard write-primary read-clipboard read-primary

# ─── Colors ─────────────────────────────────────
# include dark-theme.auto.conf
include themes/mod-box.conf
